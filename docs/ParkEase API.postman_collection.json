    {
      "name": "ParkingLots",
      "item": [
        {
          "name": "Lists parking lots. Admins see every lot; Operators see only lots they own.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parkinglots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parkinglots"
              ],
              "variable": []
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Creates a new parking lot. Operator or Admin.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/parkinglots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parkinglots"
              ],
              "variable": []
            },
            "description": "Sample request:\n            \n    POST /api/parkinglots\n    {\n       \"name\": \"Anna Nagar Lot 1\",\n       \"address\": \"12 2nd Ave, Anna Nagar, Chennai\"\n    }\n            \nThe owning user (Operator or Admin) is taken from the JWT token, not the request body.\nAn Admin who creates a lot becomes its OperatorId, same as an Operator would — Admins\nalready see every lot regardless of ownership, so this doesn't change their visibility.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"T Nagar Parking\",\n  \"address\": \"Usman Road, T Nagar, Chennai 600017\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Lists every parking lot, unfiltered — the driver-facing \"browse lots to park in\" read.\r\nOpen to any authenticated role. Not ownership-scoped like M:ParkEase.Api.Controllers.ParkingLotsController.GetLots, which\r\nbacks the Operator/Admin management dashboards instead.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parkinglots/browse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parkinglots",
                "browse"
              ],
              "variable": []
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Gets a single lot by id, subject to the same ownership scoping as the list endpoint.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parkinglots/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parkinglots",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Deletes a lot. Admin can delete any lot; Operators can only delete their own.\r\nA lot can only be deleted once it has no slots.",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parkinglots/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parkinglots",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Lists all slots for a given lot, with their live status (Available / Reserved / Occupied /\r\nMaintenance) and vehicle type. Open to any authenticated role (including Driver), since\r\nbrowsing availability is required for the booking flow — not ownership-scoped like the\r\nmanagement endpoints above.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parkinglots/:id/slots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parkinglots",
                ":id",
                "slots"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Adds a new slot to a lot. Operator/Admin only.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/parkinglots/:id/slots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parkinglots",
                ":id",
                "slots"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Sample request:\n            \n    POST /api/parkinglots/1/slots\n    {\n       \"slotNumber\": \"A1\",\n       \"hourlyRate\": 50,\n       \"vehicleType\": \"Car\"\n    }\n            \nvehicleType is Car (default) or Bike; only vehicles of that type can be booked into the slot.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slotNumber\": \"A3\",\n  \"hourlyRate\": 40,\n  \"vehicleType\": \"Car\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Takes a free slot out of service (Maintenance) or returns it to Available.\r\nReserved and Occupied slots can't be changed — they're driven by bookings.",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/parkinglots/:id/slots/:slotId/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parkinglots",
                ":id",
                "slots",
                ":slotId",
                "status"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                },
                {
                  "key": "slotId",
                  "value": "1"
                }
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Maintenance\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Deletes a slot that is free and has never been booked. Slots with booking history can't\r\nbe deleted (set them to Maintenance instead) so billing records stay intact.",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/parkinglots/:id/slots/:slotId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "parkinglots",
                ":id",
                "slots",
                ":slotId"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                },
                {
                  "key": "slotId",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Step 1 — reserves a slot for one of the driver's registered vehicles. Driver-only.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings"
              ],
              "variable": []
            },
            "description": "Sample request:\n            \n    POST /api/bookings\n    {\n       \"vehicleId\": 3,\n       \"parkingSlotId\": 12\n    }\n            \nThe slot is held for the reservation window (15 minutes by default); billing does not\nstart until check-in. The vehicle must be the driver's own and match the slot's type\n(Car/Bike), and must not already have a live booking. The driver is identified from the\nJWT. Sends an SMS and email confirmation.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"parkingSlotId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Step 2 — checks the vehicle in: the slot becomes Occupied and billing starts.",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/:id/check-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                ":id",
                "check-in"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Allowed for the driver who made the booking, the operator who owns the lot, or an admin.\nOnly Reserved bookings can be checked in, and only before the hold expires."
          },
          "response": []
        },
        {
          "name": "Step 3 — checks the vehicle out: calculates the fee (plus overstay penalty if any),\r\nfrees the slot, and sends the exit receipt.",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/:id/exit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                ":id",
                "exit"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Same access rule as check-in. Only Active (checked-in) bookings can be exited."
          },
          "response": []
        },
        {
          "name": "Cancels a reservation that hasn't been checked in yet. Free of charge.",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/:id/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                ":id",
                "cancel"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Returns the calling driver's own booking history, most recent first.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bookings",
                "mine"
              ],
              "variable": []
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Returns all bookings for a lot — who is mapped to which slot, and their status.\r\nOperator/Admin only; Operators only see lots they own.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/lot/:lotId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
