{
  "info": {
    "_postman_id": "c94d6fe2-010c-4cf5-88b9-350c000e732c",
    "name": "ParkEase API",
    "description": "Reserve a slot for a registered vehicle, check in, exit; SMS + email notifications at every step.\n\nRun **Auth > login** first: it saves the JWT into the `token` collection variable, which every other request uses.\nSeeded logins: admin@parkease.com / Admin@123, operator@parkease.com / Operator@123, driver@parkease.com / Driver@123.\nFlow: vehicles > browse lots > reserve (POST /api/bookings) > check-in > exit. Generated from the live OpenAPI document.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5241"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registers a new user (Driver, Operator, or Admin) and returns a JWT access token.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ],
              "variable": []
            },
            "description": "Sample request:\n            \n    POST /api/auth/register\n    {\n       \"fullName\": \"Sanjeev Veerapandian\",\n       \"email\": \"sanjeev@parkease.com\",\n       \"password\": \"Test@1234\",\n       \"phoneNumber\": \"9876543210\",\n       \"role\": \"Driver\"\n    }\n            \nRole must be exactly one of: Driver, Operator, Admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Dana Driver\",\n  \"email\": \"dana@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"phoneNumber\": \"9876543210\",\n  \"role\": \"Driver\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Authenticates an existing user and returns a fresh JWT access token.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "variable": []
            },
            "description": "Sample request:\n            \n    POST /api/auth/login\n    {\n       \"email\": \"sanjeev@parkease.com\",\n       \"password\": \"Test@1234\"\n    }\n            \nUse the returned token in the Authorize dialog as: Bearer <token>",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@parkease.com\",\n  \"password\": \"Driver@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ]
        }
      ]
    },
