{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "ExpiryMinutes": 60
  },
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "AutoMigrate": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Booking": {
    "ReservationHoldMinutes": 15,
    "MaintenanceIntervalSeconds": 60
  },
  "Sms": {
    "Provider": "Log",
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "From": "",
      "MessagingServiceSid": ""
    }
  }
}
